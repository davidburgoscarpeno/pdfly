---
import Base from '../layouts/Base.astro';
import { site } from '../config';
---
<Base title={`Cookie Policy | ${site.name}`} description={`Cookie policy of ${site.name}.`}>
  <h1>Cookie Policy</h1>
  <p class="lead">Last updated: September 2026</p>
  <p>{site.name} does not set tracking cookies. If analytics are enabled, the analytics provider may set its own cookies subject to its policy; where required, these are only loaded after consent.</p>
</Base>
